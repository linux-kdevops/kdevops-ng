#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: scripts/docs
##
## Render the documentation to docs/_build/html with Sphinx, its warnings
## as errors (docs/contributing/index.rst, "Documentation"):
##
##   scripts/docs
. "$(dirname "$0")/../tasks/common/task"
[ $# -eq 0 ] || usage
docs=$(dirname "$0")/../docs

transcript
sphinx-build --write-all --fail-on-warning "$docs" "$docs/_build/html"

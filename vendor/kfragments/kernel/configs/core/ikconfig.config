# Help: The kernel's .config, readable at /proc/config.gz
# A test suite that asks which options the running kernel was built
# with reads /proc/config.gz, as blktests' _have_kernel_option does.
# IKCONFIG is tristate: as a module the file is there once configs.ko
# is loaded, which blktests does not do itself.
CONFIG_IKCONFIG=m
CONFIG_IKCONFIG_PROC=y

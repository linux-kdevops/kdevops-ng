#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: tasks/b4/shazam --directory DIR --message-id ID --project NAME
##
## Apply the series posted as ID onto the commit checked out in DIR, a
## worktree of the project NAME, linux or qemu, that you add at the
## series' base, with b4:
##
##   tasks/b4/shazam --directory ~/wt/qemu \
##       --message-id 20260101-topic-v1-0-0123456789ab@example.org \
##       --project qemu
##
## Its tool's output goes to stdout and stderr in
## build/logs/b4-shazam/ of DIR.
. "$(dirname "$0")/../common/task"
: "${directory:?} ${message_id:?} ${project:?}"
directory=$(realpath "$directory")
# Where b4 keeps the thread and what b4 ty reads, and krecord the
# records, if you moved them.
variables=(XDG_CACHE_HOME XDG_DATA_HOME XDG_STATE_HOME)
# git am writes the worktree and the repository it belongs to.
settings=(--property=ReadWritePaths="$directory"
	--property=ReadWritePaths="$(git -C "$directory" rev-parse --path-format=absolute --git-common-dir)"
	--property=CacheDirectory=b4
	--property=ReadWritePaths="-${XDG_DATA_HOME:-$HOME/.local/share}/b4")
# The record lies under the Message-ID, as tasks/b4/mbox's does.
record=(--project "$project" --command "b4 shazam" --message-id-file build/logs/b4-shazam/message-id
	--output=b4/shazam.json)
. "$(dirname "$0")/../common/unit"

transcript
echo "$message_id" | tee "$log/message-id"
"${unit[@]}" b4 --no-stdin shazam --add-link "$message_id"

#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: tasks/smatch/uninstall
##
## Remove the smatch that tasks/smatch/install installed for you: its
## link in ~/.local/bin and ~/.local/lib/smatch:
##
##   tasks/smatch/uninstall
. "$(dirname "$0")/../common/task"
. "$(dirname "$0")/../common/prefix"

transcript
rm --force --verbose "$link"
rm --recursive --force --verbose "$prefix"

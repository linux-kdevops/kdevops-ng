#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: tasks/blktests/check --group GROUP
##
## Run the blktests group GROUP, or one test of it, on this machine,
## and keep what blktests writes of each test in
## /var/lib/blktests/BUILD/GROUP/, with what it prints beside it as
## GROUP.stdout. BUILD is the release of the kernel that runs and the
## first twelve digits of the sha256 of its .config. blktests reads
## the machine's /var/lib/blktests/config. Run it as root where
## blktests is installed, in a guest:
##
##   tasks/blktests/check --group nvme
##   tasks/blktests/check --group block/001
. "$(dirname "$0")/../common/task"
: "${group:?}"
sum=$(zcat /proc/config.gz | sha256sum)
build=/var/lib/blktests/$(uname --kernel-release)-${sum::12}
output=$build/$group
printed=$build/${group//\//-}.stdout

transcript
# The host's share, which holds the config and takes the results.
systemctl start var-lib-blktests.mount
# What a record of a test names and the results lack: the machine it
# ran on and the blktests that ran it.
mkdir --parents --verbose "$build/machine"
cp --verbose /proc/cpuinfo /proc/meminfo /proc/sys/kernel/arch \
	/usr/lib/blktests/version /usr/lib/blktests/url \
	"$build/machine"
# What an earlier run left would pass for this one's.
rm --recursive --force "$output"
# check runs from its own directory.
# shellcheck disable=SC2164 # errexit ends the task where cd fails
cd /usr/lib/blktests
# blktests says why a test did not run in what it prints, and nowhere
# else: a record of the test reads it from this file.
./check --config=/var/lib/blktests/config --output="$output" "$group" 2>&1 |
	tee "$printed"

# shellcheck shell=bash disable=SC2034 # blktests' check reads them
# SPDX-License-Identifier: copyleft-next-0.3.1
# blktests' configuration for a guest of guest-blktests.qemu, which
# check sources (Documentation/running-tests.md of blktests). Copy it
# to blktests/ of the guest's state directory and change the lines
# marked CHANGE.

# CHANGE: the devices a test that needs one runs on, once on each,
# and overwrites: the machine's NVMe namespaces, the second with
# metadata.
TEST_DEVS=(/dev/nvme0n1 /dev/nvme0n2)

# The user of the tests that run a command without privileges, which
# tasks/libguestfs/blktests made in the guest.
NORMAL_USER=blktests

# The transports the nvme group sets its targets up on: it runs each
# test once for every one named, and a test of one transport is not
# run on another. All four take the group four times as long as loop
# alone, which is blktests' own default.
NVMET_TRTYPES="loop tcp rdma fc"

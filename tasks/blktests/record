#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: tasks/blktests/record --directory DIR --machine NAME
##
## File what blktests left of each test in the guest of the machine
## NAME, on the kernel the Linux tree in DIR built, as records of that
## build, with kresults' krecord blktests. The machine is running:
## its QEMU is the one a record names.
##
##   tasks/blktests/record --directory ~/linux --machine guest
##
## Its tool's output goes to stdout and stderr in
## build/logs/blktests-record/ of DIR.
. "$(dirname "$0")/../common/task"
. "$(dirname "$0")/../common/kbuild"
: "${machine:?}"
# krecord blktests writes where the build's other records lie.
settings+=(--property=StateDirectory=krecords)
. "$(dirname "$0")/../common/unit"
# The results lie in the machine's state directory, under the release
# of the kernel that ran and the sha256 of its .config: this build's.
sum=$(sha256sum <"$build/.config")
results=${XDG_STATE_HOME:-$HOME/.local/state}/qemu-system/$machine/blktests
results+=/$(<"$build/include/config/kernel.release")-${sum::12}
# The QEMU the machine runs, by the process itself: the file its unit
# names may have been built again since.
pid=$(systemctl --user show --property=MainPID --value "qemu-system@$machine.service")
qemu=$(readlink "/proc/$pid/exe")

transcript
"${unit[@]}" krecord blktests --results "$results" "${config[@]}" \
	--qemu "$qemu" "${producer[@]}"

# The build of the QEMU tree in $directory: $build, build/ of the tree,
# where QEMU's configure and Meson keep what they make. $make is the make
# that builds it, and $variables configure's own that name the compilers.
: "${directory:?}"
directory=$(realpath "$directory")
build=$directory/build
variables=(CC CXX)
make=(make --directory=build --jobs="$(nproc)")

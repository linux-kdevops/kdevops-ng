# What every task starts from (designs/tasks.md, "Writing a task"): strict
# mode, the ## header as --help and as the usage error, the options its
# usage line names, and the transcript.
set -o errexit -o nounset -o pipefail

header() { sed --quiet 's/^## \{0,1\}//p' "$0"; }
usage() { header >&2 && exit 2; }
if [ "${1-}" = --help ]; then
	header
	exit 0
fi
# The usage line is the one form a task takes: each "--option VALUE" of it,
# in its order, becomes the variable of the option's name.
read -r -a form <<<"$(sed --quiet 's/^## Usage: [^ ]* //p' "$0")"
[ $# -eq ${#form[@]} ] || usage
while [ $# -gt 0 ]; do
	[ "$1" = "${form[0]}" ] || usage
	option=${1#--}
	declare "${option//-/_}=$2"
	shift 2
	form=("${form[@]:2}")
done
# The log from here on: each command after a "$ " prompt, as it ran. A
# task that fails ends it with the exit status of its last command, after
# settle has shown what was still to show (tasks/common/unit).
settle() { :; }
transcript() {
	exec {stderr}>&2 2>&1
	# shellcheck disable=SC2154 # the trap assigns status itself
	trap '{ status=$? && set +o xtrace; } 2>/dev/null
		settle
		[ "$status" -eq 0 ] || echo "$0: exit status $status" >&$stderr' EXIT
	PS4='$ '
	set -o xtrace
}

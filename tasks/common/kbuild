# shellcheck shell=bash disable=SC2034 # the task that sources this reads them
# SPDX-License-Identifier: copyleft-next-0.3.1
# The build of the Linux tree in $directory: $build, build/ of the tree,
# where kbuild keeps what it makes apart from the sources. $make is the
# make every kernel task runs in the tree, and $variables kbuild's own that
# say what it builds. $settings lets the unit write the build and nothing
# else of the tree, and $config is what krecord files a run under: the
# build's .config and its name.
: "${directory:?}"
directory=$(realpath "$directory")
build=$directory/build
variables=(ARCH LLVM)
# What Documentation/kbuild/reproducible-builds.rst asks of a build, so
# the same commit, configuration and tools give the same files on any
# host: the commit's date for the build's, no user or host of this one,
# no count of the builds made here, and no path of the tree.
make=(make O=build --jobs="$(nproc)"
	KBUILD_BUILD_TIMESTAMP="$(git -C "$directory" log --max-count=1 --format=%cI)"
	KBUILD_BUILD_USER=kdevops-ng KBUILD_BUILD_HOST=kdevops-ng KBUILD_BUILD_VERSION=1
	KCFLAGS="-fdebug-prefix-map=$directory/=" KAFLAGS="-fdebug-prefix-map=$directory/="
	KRUSTFLAGS="--remap-path-prefix=$directory/=")
settings=(--property=ReadOnlyPaths="$directory"
	--property=ReadWritePaths="-$build")
config=(--config build/.config --configuration-file build/.config.name)

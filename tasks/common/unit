# shellcheck shell=bash disable=SC2034 # the task that sources this reads it
# SPDX-License-Identifier: copyleft-next-0.3.1
# The unit a task runs its tool in, as "${unit[@]}" before the tool's
# command: a transient unit of the developer's service manager, named for
# the task and its process. It runs in $directory and sees the developer's
# home read-only (designs/principles.md, 4). $settings are the options of
# systemd-run a task or its tasks/common file adds: what of $directory
# the tool may write.
# systemd writes the tool's standard output and standard error to the
# files stdout and stderr of $log, a directory of the tree's build/ named
# for the task, and for the object where the task checks one
# (designs/output.md). The tool's exit status is the task's.
# The unit gets none of the caller's environment, so each of $variables
# that is set is named, and the log shows it (designs/tasks.md, I2). A tool
# that reads none has an empty list, and declare fails where a task names
# none.
: "${directory:?} ${settings[*]:?}"
# shellcheck disable=SC2154 # the task sets it
declare -p variables >/dev/null
task=$(basename "$(dirname "$0")")-$(basename "$0")
name=$task-$$.service
log=build/logs/$task${object:+/$object}
unit=(systemd-run --user --unit="$name" --wait --collect
	--working-directory="$directory"
	--property=PrivateUsers=yes --property=ProtectHome=read-only
	"${settings[@]}" --property=ReadWritePaths="$directory/$log"
	--property=StandardOutput="append:$directory/$log/stdout"
	--property=StandardError="append:$directory/$log/stderr")
# A task that leaves a record names krecord's options in $record
# (designs/tasks.md, R1): systemd runs krecord as the tool exits, pass or
# fail. The record holds the files of $log that $outputs names, stderr
# where the task names none (R2). The "-" has systemd ignore krecord's
# exit status and env finds krecord on the unit's PATH, so a host without
# krecord still does the work. A word with a space is quoted, and a quote
# in it escaped, as systemd reads the line. $producer is who a record
# says made it, for a task that hands krecord its options itself.
producer=(--producer kdevops-ng --producer-tree "$(realpath "$(dirname "$0")")")
if [ -n "${record[*]-}" ]; then
	stop="-env krecord"
	for output in "${outputs[@]-stderr}"; do
		record+=(--output-file "$log/$output")
	done
	for word in "${record[@]}" "${producer[@]}"; do
		case $word in *' '*) word="\"${word//\"/\\\"}\"" ;; esac
		stop+=" $word"
	done
	unit+=(--property=StateDirectory=krecords --property=ExecStopPost="$stop")
fi
unit+=(--setenv=PATH)
for variable in "${variables[@]}"; do
	if [ -n "${!variable-}" ]; then
		unit+=(--setenv="$variable=${!variable}")
	fi
done
# The task works from $directory on, as a developer would: systemd-run
# looks a tool named by a path up from where it is started. The two files
# start empty, since systemd appends to them, and tail shows their lines
# as they come. tail ends once the process --pid names does, after
# reading what is left: settle ends that process when the task is done.
prepare() {
	set -o xtrace
	# shellcheck disable=SC2164 # errexit ends the task where cd fails
	cd "$directory"
	mkdir --parents "$log"
	truncate --size=0 "$log/stdout" "$log/stderr"
	sleep infinity &
	tail --quiet --follow --sleep-interval=0.1 --pid=$! "$log/stdout" "$log/stderr" &
}
settle() {
	kill %sleep && wait
}
# systemd-run leaves its unit running when it is interrupted: the unit
# stops with the task.
trap 'systemctl --user stop "$name"' INT TERM HUP

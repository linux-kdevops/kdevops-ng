# shellcheck shell=bash disable=SC2034 # the task that sources this reads it
# SPDX-License-Identifier: copyleft-next-0.3.1
# The unit a task runs its tool in, as "${unit[@]}" before the tool's
# command: a transient unit of the developer's service manager, named for
# the task and $directory, so the same task is refused a second run there
# while one lasts. The unit's settings are the drop-ins under its name in
# units/user: where it runs, what it may write, what files its record.
# systemd-cat sends the tool's standard output to the journal as it is and
# its standard error as warnings, each line under the unit's name as its
# identifier. journald names a line's unit only while the process that
# wrote it lives, so a compiler's last errors would carry none: the
# identifier is what finds every line. The tool's exit status is the
# task's.
# The unit gets none of the caller's environment, so each of $variables
# that is set is named, and the log shows it (designs/tasks.md, I2).
: "${directory:?} ${variables[*]:?}"
task=$(basename "$(dirname "$0")")-$(basename "$0")
name=$(systemd-escape --path "$directory" --template="$task@.service")
# Without its drop-ins the unit would run in no tree, write anywhere and
# file nothing, so a task that finds them not linked says so and stops.
if [ ! -d "$HOME/.local/share/systemd/user/$task@.service.d" ]; then
	echo "$0: link the units' settings first:" \
		"docs/getting-started/requirements.rst, \"The units' settings\"" >&2
	exit 1
fi
unit=(systemd-run --user --unit="$name" --wait --collect --setenv=PATH)
for variable in "${variables[@]}"; do
	if [ -n "${!variable-}" ]; then
		unit+=(--setenv="$variable=${!variable}")
	fi
done
unit+=(systemd-cat --identifier="$name" --stderr-priority=warning)
# The unit's lines, shown as they come: journalctl follows the identifier
# from where the journal ends now, and keeps its place in $cursor. As the
# task ends, settle stops it and shows what it had not reached.
cursor=$(mktemp)
journalctl --user --lines=0 --quiet --show-cursor |
	sed --quiet 's/^-- cursor: //p' >"$cursor"
journalctl --user --follow --output=cat --identifier="$name" \
	--cursor-file="$cursor" &
settle() {
	journalctl --sync
	kill %% && wait
	journalctl --user --output=cat --identifier="$name" --cursor-file="$cursor"
	rm "$cursor"
}
# systemd-run leaves its unit running when it is interrupted, and the next
# run of the task would be refused: the unit stops with the task.
trap 'systemctl --user stop "$name"' INT TERM HUP

#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: tasks/fio/record --directory DIR --machine NAME --job JOB
##
## File the sample that the fio job JOB left in the guest of the machine
## NAME, on the kernel the Linux tree in DIR built, as a record of that
## build, with kresults' krecord sample. The metrics are iops, bandwidth
## and the mean and 99th percentile completion latency of the job's
## writes, and the writes and merges of its device. A job that failed is
## a record too, with its exit status:
##
##   tasks/fio/record --directory ~/linux --machine fio-atomic-series \
##       --job atomic-merge
##
## Its tool's output goes to stdout and stderr in
## build/logs/fio-record/ of DIR, and the metrics beside them.
. "$(dirname "$0")/../common/task"
. "$(dirname "$0")/../common/kbuild"
: "${machine:?} ${job:?}"
# krecord writes where the build's other records lie.
settings+=(--property=StateDirectory=krecords)
. "$(dirname "$0")/../common/unit"
files=$(realpath "$(dirname "$0")")/files
# The results lie in the machine's state directory, under the release of
# the kernel that ran and the sha256 of its .config: this build's.
sum=$(sha256sum <"$build/.config")
share=${XDG_STATE_HOME:-$HOME/.local/state}/qemu-system/$machine/fio
results=$share/$(<"$build/include/config/kernel.release")-${sum::12}
# The device is the one the config names, and disk_util lists it by its
# name without /dev/.
device=$(sed --quiet 's|^DEVICE=/dev/||p' "$share/config")
# When the job started, how long fio ran and its exit status, as the
# JSON has them.
IFS=$'\t' read -r started seconds exit_status \
	< <(jq --raw-output --from-file "$files/sample.jq" "$results/$job/fio.json")
# The QEMU the machine runs, by the process itself: the file its unit
# names may have been built again since.
pid=$(systemctl --user show --property=MainPID --value "qemu-system@$machine.service")
qemu=$(readlink "/proc/$pid/exe")

transcript
jq --raw-output --arg device "$device" --from-file "$files/metrics.jq" \
	"$results/$job/fio.json" >"$log/metrics"
# The record is named for the device and the job, as blktests' are for
# the device and the test. The job is hashed from this tree's file, the
# one the install put in the guest.
"${unit[@]}" krecord sample --command "fio $job.fio" \
	--output "fio/$device/$job.json" --exit "$exit_status" \
	--started "$started" --seconds "$seconds" \
	--machine "$results/machine" --install "$results/machine" \
	--qemu "$qemu" --metrics "$log/metrics" --job "$files/jobs/$job.fio" \
	--output-file "$results/$job/stderr" "${config[@]}" "${producer[@]}"

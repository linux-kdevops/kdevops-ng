## Usage: tasks/qemu-system/journal --machine NAME
##
## Show the console of the machine NAME since it last started:
##
##   tasks/qemu-system/journal --machine guest
. "$(dirname "$0")/../common/task"
: "${machine:?}"

transcript
journalctl --no-pager --user-unit="qemu-system@$machine.service" --invocation=0

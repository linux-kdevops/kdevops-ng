## Usage: tasks/qemu-system/start --machine NAME
##
## Start the machine NAME, which ~/.config/qemu/systemd/NAME.qemu
## describes, with the units qemu-system-generator made of it:
##
##   tasks/qemu-system/start --machine guest
. "$(dirname "$0")/../common/task"
: "${machine:?}"

transcript
systemctl --user start "qemu-system@$machine.service"

# SPDX-License-Identifier: copyleft-next-0.3.1
# One machine of the guest-blktests-* family: what it alone has, beside the
# lines of guest-blktests-.qemu.d and guest-blktests-series-.qemu.d. Copy it once
# for each machine, under the machine's name.

[QEMU]
# CHANGE: a vsock number no other machine of this host has.
device=vhost-vsock-pci-non-transitional,guest-cid=110

# CHANGE: the machine's name. blktests' config and results: virtiofsd
# does not start without the directory. A drop-in cannot name it for
# every machine, since %i in this section is the daemon's name, the
# machine's and the tag.
[virtiofsd]
shared-dir=%S/qemu-system/guest-blktests-series-block/blktests
tag=blktests
sandbox=namespace
uid-map=:0:%U:1:
gid-map=:0:%G:1:

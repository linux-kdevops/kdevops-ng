# SPDX-License-Identifier: copyleft-next-0.3.1
# guest-nvme.qemu with the share that holds blktests' config and takes
# its results, blktests/ of the guest's state directory. Copy it to
# ~/.config/qemu/systemd/NAME.qemu, change the lines marked CHANGE, and
# make the shared directory, with the config, in the guest's state
# directory:
#
#   mkdir --verbose ~/.local/state/qemu-system/NAME/blktests
#   cp --verbose tasks/blktests/files/config \
#       ~/.local/state/qemu-system/NAME/blktests/

[VM]
# The key root's ssh takes, which tasks/libguestfs/customize put in the
# guest: the unit powers the guest off with it.
SSHPrivateKey=%h/.ssh/guests
# The QEMU a tree of yours built, in place of the host's:
#QEMUBinary=%h/qemu/build/qemu-system-x86_64

[Service]
# The namespaces start empty at each start of the machine: what a test
# wrote is of no use to the next, and a sparse file takes the room of
# what was written and no more.
ExecStartPre=rm --force nvme0.raw nvme1.raw
ExecStartPre=truncate --size=1G nvme0.raw nvme1.raw

[QEMU]
machine=q35
nodefaults=
accel=kvm
cpu=host
# The debug options of the blktests profile take memory: with 2G the
# kernel kills a test of the block group for want of it.
m=4G
smp=4
nographic=
serial=mon:stdio
# The guest's disk, in its state directory.
drive=file=work.qcow2,if=virtio,format=qcow2
# CHANGE: your Linux tree, here and in the modules share below.
kernel=%h/linux/build/arch/x86_64/boot/bzImage
initrd=%h/linux/build/initrd
# root= is the image's root partition: the first on Debian and Ubuntu.
append=console=ttyS0 root=/dev/vda1 rw TERM=dumb
netdev=user,id=net0
device=virtio-net-pci-non-transitional,netdev=net0
# CHANGE: a vsock number no other machine of this host has.
device=vhost-vsock-pci-non-transitional,guest-cid=100
device=nvme,serial=nvme0,id=nvme0,ioeventfd=on
# Nothing of a namespace outlasts the machine, so QEMU flushes none of
# it (cache=unsafe), and what the guest discards goes back to the host.
drive=file=nvme0.raw,if=none,format=raw,cache=unsafe,discard=unmap,detect-zeroes=unmap,id=nvme0-ns0
# CHANGE: the namespace's options, after bus=nvme0, as the test needs.
device=nvme-ns,drive=nvme0-ns0,bus=nvme0,logical_block_size=4096,physical_block_size=4096
# A second namespace, with eight bytes of metadata for each block: a
# test of the metadata is not run on one without.
drive=file=nvme1.raw,if=none,format=raw,cache=unsafe,discard=unmap,detect-zeroes=unmap,id=nvme0-ns1
device=nvme-ns,drive=nvme0-ns1,bus=nvme0,ms=8,logical_block_size=4096,physical_block_size=4096

[virtiofsd]
shared-dir=%h/linux/build/mod-install/lib/modules
tag=modules
cache=always
sandbox=namespace
uid-map=:0:%U:1:
gid-map=:0:%G:1:

# CHANGE: the machine's name. virtiofsd does not start without the
# directory.
[virtiofsd]
shared-dir=%S/qemu-system/guest/blktests
tag=blktests
sandbox=namespace
uid-map=:0:%U:1:
gid-map=:0:%G:1:

[virtiofsd]
shared-dir=%h
tag=home
sandbox=namespace
uid-map=:0:%U:1:
gid-map=:0:%G:1:

[Install]
WantedBy=machines.target

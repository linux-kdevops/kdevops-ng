## Usage: tasks/qemu-system/restart --machine NAME
##
## Stop the machine NAME and start it again, as after a kernel rebuild:
##
##   tasks/qemu-system/restart --machine guest
. "$(dirname "$0")/../common/task"
: "${machine:?}"

transcript
systemctl --user restart "qemu-system@$machine.service"

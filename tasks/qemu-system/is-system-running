## Usage: tasks/qemu-system/is-system-running --machine NAME
##
## Say whether the guest of the machine NAME has booted, as its own
## systemd does: wait for the boot to end and print the state it ends
## in, running where every unit started.
##
##   tasks/qemu-system/is-system-running --machine guest
##
## It fails while the guest takes no connection yet, and where a unit
## of the guest failed. It runs on the host and reaches the guest as
## systemctl does with --host.
. "$(dirname "$0")/../common/task"
: "${machine:?}"

transcript
systemctl --host "$machine" is-system-running --wait

#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: tasks/qemu-system/machine --machine NAME --directory DIR --distribution NAME
##
## Describe the machine NAME, which boots the kernel of the Linux tree
## in DIR on a disk of the distribution NAME, as
## tasks/libguestfs/download_image takes it: its file in
## ~/.config/qemu/systemd, with a vsock number no other machine there
## has, beside the lines its family shares. The
## family is the first word of the name, blktests of
## blktests-nvme-tcp-series, and tasks/qemu-system/files/families has
## its files. qemu-system-generator then makes the machine's units:
##
##   tasks/qemu-system/machine --machine blktests-nvme-tcp-series \
##       --directory ~/linux --distribution debian-14
##
## A second run for another tree keeps the machine's number, and the
## family's lines are left as they are found.
. "$(dirname "$0")/../common/task"
: "${machine:?} ${directory:?} ${distribution:?}"
directory=$(realpath "$directory")
# The distribution's file says where its image keeps its root. Its
# other lines are the download's, and read $gpg.
# shellcheck disable=SC2034 # the distribution's file reads it
gpg=()
# shellcheck source=tasks/libguestfs/files/images/debian-13
. "$(dirname "$0")/../libguestfs/files/images/$distribution"
family=${machine%%-*}
files=$(realpath "$(dirname "$0")")/files/families/$family
config=${XDG_CONFIG_HOME:-$HOME/.config}/qemu/systemd
# The machine's vsock number: the one its file has, or one above the
# highest of the machines there, from 100.
number='s/.*guest-cid=\([0-9]*\).*/\1/p'
cid=$(sed --quiet "$number" "$config/$machine.qemu" 2>/dev/null || true)
if [ -z "$cid" ]; then
	highest=$({ cat "$config"/*.qemu 2>/dev/null || true; } |
		sed --quiet "$number" | sort --numeric-sort | tail --lines=1)
	cid=$((${highest:-99} + 1))
fi

transcript
mkdir --parents --verbose "$config"
cp --recursive --update=none --verbose "$files/$family-.qemu.d" "$config"
sed --expression="s|@cid@|$cid|" --expression="s|@directory@|$directory|" \
	--expression="s|@root@|$root|" \
	"$files/machine.qemu" | tee "$config/$machine.qemu"
systemctl --user start qemu-system-generator.service

#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: tasks/kernel/objects --directory DIR
##
## List the object files the build of the Linux tree in DIR compiles from
## the C files its series changes, with kresults' krecord objects:
##
##   tasks/kernel/objects --directory ~/linux
##
## Its tool's output goes to stdout and stderr in
## build/logs/kernel-objects/ of DIR.
. "$(dirname "$0")/../common/task"
. "$(dirname "$0")/../common/kbuild"
# krecord objects writes the list beside the build's records.
settings+=(--property=StateDirectory=krecords)
. "$(dirname "$0")/../common/unit"

transcript
"${unit[@]}" krecord objects "${config[@]}"

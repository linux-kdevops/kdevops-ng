#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: tasks/kernel/series --directory DIR --range RANGE
##
## Name the commits of RANGE in the Linux tree in DIR as the series the
## tree's records are of, with kresults' kseries:
##
##   tasks/kernel/series --directory ~/linux --range v7.3..
##
## Its tool's output goes to stdout and stderr in
## build/logs/kernel-series/ of DIR.
. "$(dirname "$0")/../common/task"
: "${range:?}"
. "$(dirname "$0")/../common/kbuild"
# kseries writes the series where krecord files the tree's records.
settings+=(--property=StateDirectory=krecords)
. "$(dirname "$0")/../common/unit"

# A series applied from a mailing list has its thread where
# tasks/b4/mbox keeps it, and a tree that came from no mail has none.
# kseries leaves aside a thread whose patches are not the range's.
mbox=build/logs/b4-mbox/thread.mbx

transcript
"${unit[@]}" kseries --range "$range" --mbox "$mbox"

#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: tasks/kernel/kconfig --directory DIR --target TARGET
##
## Make build/.config of the Linux tree in DIR with make's configuration
## target TARGET:
##
##   tasks/kernel/kconfig --directory ~/linux --target tinyconfig
##
## Its tool's output goes to stdout and stderr in
## build/logs/kernel-kconfig/ of DIR.
. "$(dirname "$0")/../common/task"
: "${target:?}"
. "$(dirname "$0")/../common/kbuild"
record=(--command "make {configuration}" "${config[@]}")
. "$(dirname "$0")/../common/unit"

transcript
mkdir --parents --verbose "$build"
rm --force --verbose "$build/.config"
echo "$target" | tee "$build/.config.name"
"${unit[@]}" "${make[@]}" "$target"

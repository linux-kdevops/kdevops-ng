#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: tasks/qemu/series --directory DIR --range RANGE
##
## Name the commits of RANGE in the QEMU tree in DIR as the series the
## tree's records are of, with kresults' krecord series:
##
##   tasks/qemu/series --directory ~/qemu --range v11.1.0..
##
## Its tool's output goes to stdout and stderr in
## build/logs/qemu-series/ of DIR.
. "$(dirname "$0")/../common/task"
: "${range:?}"
. "$(dirname "$0")/../common/qemu"
# krecord series writes the series beside the tree's records.
settings+=(--property=StateDirectory=krecords)
. "$(dirname "$0")/../common/unit"

# A series applied from a mailing list has its thread where
# tasks/b4/mbox keeps it, and a tree that came from no mail has none.
# krecord series leaves aside a thread whose patches are not the
# range's.
mbox=build/logs/b4-mbox/thread.mbx

transcript
"${unit[@]}" krecord series --project qemu --range "$range" --mbox "$mbox"

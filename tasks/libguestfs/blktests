#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: tasks/libguestfs/blktests --directory DIR --copy-in TREE
##
## Install blktests from your tree TREE into work.qcow2, the disk of the
## guest whose state directory is DIR, as /usr/lib/blktests: the tree,
## copied in, built and installed in the disk, and with it the units
## that run a group of its tests and mount the host's share for their
## results, and the user its tests run unprivileged commands as. The
## disk has what blktests builds with once
## tasks/libguestfs/install has run its blktests profile. The guest
## must be stopped:
##
##   tasks/libguestfs/blktests --directory ~/.local/state/qemu-system/guest \
##       --copy-in ~/blktests
. "$(dirname "$0")/../common/task"
: "${directory:?} ${copy_in:?}"
copy_in=$(realpath "$copy_in")
tree=/work/$(basename "$copy_in")
jobs=$(nproc)
checkout=$copy_in
. "$(dirname "$0")/../common/origin"
# The units that run a group, each uploaded with the developer's owner
# and mode, which a file of /usr/lib does not keep.
system=/usr/lib/systemd/system
units=()
for unit in "$(realpath "$(dirname "$0")")"/files/units/*; do
	file=$system/$(basename "$unit")
	units+=(--upload "$unit:$file" --chown "0:0:$file" --chmod "0644:$file")
done
# systemd-sysusers makes the user of the file, or leaves the one a run
# before this made.
users=/usr/lib/sysusers.d/blktests.conf
user=(
	--upload "$(realpath "$(dirname "$0")")/files/sysusers/blktests.conf:$users"
	--chown "0:0:$users" --chmod "0644:$users"
	--run-command "systemd-sysusers $users"
)

transcript
# The build runs in virt-customize's appliance, which --memsize and
# --smp size. blktests installs as one directory of its own, which goes
# under /usr/lib, where a package keeps what is its alone, in place of
# the Makefile's /usr/local. The copy goes when it is installed. The
# version file names the commit installed, which a record of a test
# gives as blktests' build, since blktests prints no version, and the
# url file where to read it.
virt-customize --format qcow2 --add "$directory/work.qcow2" \
	--memsize 4096 --smp "$jobs" \
	--mkdir /work --copy-in "$copy_in:/work" \
	--run-command "make --directory=$tree --jobs=$jobs" \
	--run-command "make --directory=$tree prefix=/usr/lib install" \
	--delete /work \
	--write "/usr/lib/blktests/version:$version" \
	--write "/usr/lib/blktests/url:$url" \
	"${units[@]}" "${user[@]}"

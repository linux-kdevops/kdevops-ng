#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: tasks/libguestfs/customize --directory DIR --hostname NAME --ssh-inject FILE
##
## Set up work.qcow2, the disk of the guest whose state directory is DIR,
## before its first boot: its name, its host keys, the public key FILE
## for root, its network, and the two shares of the host: the modules
## of the kernel it boots, and your home at the path it has here, which
## is root's home in the guest. The guest must be stopped:
##
##   tasks/libguestfs/customize --directory ~/.local/state/qemu-system/guest \
##       --hostname guest --ssh-inject ~/.ssh/guests.pub
. "$(dirname "$0")/../common/task"
: "${directory:?} ${hostname:?} ${ssh_inject:?}"
ssh_inject=$(realpath "$ssh_inject")
# The modules line is marked x-initrd.mount: the initrd mounts the share
# before the guest's own systemd starts and asks for a module. The path
# is /usr/lib/modules, since /lib is a link on a merged-usr root and
# systemd refuses a mount whose path runs through one.
# Each fstab line carries this option, which mount ignores, so a second
# run takes the lines of the first out before it adds its own.
mark=x-kdevops-ng
# Root's home is yours, so a login lands in your files with your shell's
# settings, and what either side writes there is yours on the host:
# virtiofsd gives the guest's root your user. The home is set in
# /etc/passwd itself: usermod refuses to change a user that runs a
# process, as root does where virt-customize works. sshd takes root's
# key from ~/.ssh of that home, whatever its configuration says, when
# systemd starts it for a connection over vsock: the disk's /root/.ssh
# is mounted there, with FILE as the one key that opens the guest.
ssh=/root/.ssh
# DHCP on every Ethernet card, for systemd-networkd, which Debian and
# Ubuntu run with no configuration once cloud-init is off. Fedora's
# NetworkManager asks by itself, and its networkd, which is off, reads
# no file. A card no DHCP server answers, as one on a segment guests
# share, takes a link-local address, and multicast DNS, which
# systemd-resolved leaves off, names each guest NAME.local to the others.
network='[Match]
Type=ether

[Network]
DHCP=yes
LinkLocalAddressing=fallback
MulticastDNS=yes
'
resolve='[Resolve]
MulticastDNS=yes
'

transcript
# cloud-init would write the network, the host keys and the machine's
# name over these at the first boot. The last three lines mask what of
# your home a guest's root must not read or write: your keys and the
# hosts ssh trusts, and the units your service manager starts.
virt-customize --add "$directory/work.qcow2" \
	--hostname "$hostname" \
	--run-command 'ssh-keygen -A' \
	--touch /etc/cloud/cloud-init.disabled \
	--mkdir "$ssh" --chmod "0700:$ssh" \
	--upload "$ssh_inject:$ssh/authorized_keys" \
	--chown "0:0:$ssh/authorized_keys" --chmod "0600:$ssh/authorized_keys" \
	--edit "/etc/passwd:s|^(root:[^:]*:0:0:[^:]*):[^:]*:|\$1:$HOME:|" \
	--write "/etc/systemd/network/80-kdevops-ng.network:$network" \
	--mkdir /etc/systemd/resolved.conf.d \
	--write "/etc/systemd/resolved.conf.d/80-kdevops-ng.conf:$resolve" \
	--mkdir "$HOME" \
	--edit "/etc/fstab:\$_ = '' if /$mark/" \
	--append-line "/etc/fstab:modules /usr/lib/modules virtiofs x-initrd.mount,$mark 0 0" \
	--append-line "/etc/fstab:home $HOME virtiofs $mark 0 0" \
	--append-line "/etc/fstab:$ssh $HOME/.ssh none bind,ro,nosuid,nodev,$mark 0 0" \
	--append-line "/etc/fstab:tmpfs $HOME/.config/systemd tmpfs ro,nosuid,nodev,mode=0555,$mark 0 0" \
	--append-line "/etc/fstab:tmpfs $HOME/.local/share/systemd tmpfs ro,nosuid,nodev,mode=0555,$mark 0 0"

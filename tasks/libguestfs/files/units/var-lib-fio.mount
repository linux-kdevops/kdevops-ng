# SPDX-License-Identifier: copyleft-next-0.3.1
# The share of the host that holds fio's config and takes its results:
# fio/ of the machine's state directory, which the machine's file shares
# under the tag fio. Nothing mounts it at boot, so a machine without the
# share boots as before.

[Unit]
Description=fio results, in the machine's state directory

[Mount]
What=fio
Where=/var/lib/fio
Type=virtiofs

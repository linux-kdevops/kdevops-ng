# Debian 13, the generic cloud image. Debian signs neither the image
# nor its checksums, so there is no key to import and nothing to verify:
# the checksums are as good as the TLS they come over.
declare -A arch=([x86_64]=amd64 [aarch64]=arm64)
site=https://cloud.debian.org/images/cloud/trixie/latest
urls=("$site/debian-13-genericcloud-${arch[$(uname --machine)]}.qcow2" "$site/SHA512SUMS")
import=()
verify=()
check=(sha512sum --check --ignore-missing SHA512SUMS)
# What the kernel command line of a machine names as the image's root.
root=root=/dev/vda1

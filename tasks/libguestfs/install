#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: tasks/libguestfs/install --directory DIR --install PACKAGE[,PACKAGE...]
##
## Install the packages named, with the guest's own package manager,
## into work.qcow2, the disk of the guest whose state directory is DIR.
## The guest must be stopped:
##
##   tasks/libguestfs/install --directory ~/.local/state/qemu-system/guest \
##       --install nvme-cli,fio,blktrace
. "$(dirname "$0")/../common/task"
: "${directory:?} ${install:?}"

transcript
virt-customize --format qcow2 --add "$directory/work.qcow2" --install "$install"

#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: tasks/pgpkeys/verify --directory DIR
##
## Check that the commit checked out in DIR, a clone of the kernel.org
## keyring, is signed by its maintainer's key, which this task names:
##
##   tasks/pgpkeys/verify --directory ~/.cache/b4/pgpkeys
. "$(dirname "$0")/../common/task"
: "${directory:?}"
# Konstantin Ryabitsev's key, which signs the keyring's commits.
signer=DE0E66E32F1FDD0902666B96E63EDCA9329DD07E
# gpg's home for this check alone, so it trusts the one key the task
# names and none of yours. It goes with the task, pass or fail.
home=$(mktemp --directory)
settle() { rm --recursive --force "$home"; }

transcript
# No agent: the home holds public keys alone.
gpg --homedir "$home" --batch --quiet --no-autostart --import \
	"$directory/keys/${signer: -16}.asc"
printf '%s:6:\n' "$signer" | gpg --homedir "$home" --batch --quiet --no-autostart \
	--import-ownertrust
env GNUPGHOME="$home" git -C "$directory" -c gpg.minTrustLevel=ultimate verify-commit HEAD

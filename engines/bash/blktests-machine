#!/usr/bin/env bash
# SPDX-License-Identifier: copyleft-next-0.3.1
## Usage: engines/bash/blktests-machine --machine NAME --directory DIR --distribution NAME [--qemu DIR] [--drop-in FILE] [--backing-file FILE] [--ssh-inject FILE]
##
## Make the machine NAME of a family, blktests-* or fio-*, which boots
## the kernel of the Linux tree in DIR on a disk of the distribution
## NAME: its description, its family's config, and its disk as an
## overlay of FILE, a disk with the suites in it that no machine starts,
## under the host name NAME and with the key FILE for root. Without
## them, FILE is the disk engines/bash/blktests-disk made of the
## distribution, and the key ~/.ssh/guests.pub. With --qemu the machine
## runs the QEMU the tree in DIR built, and the host's without. With
## --drop-in it has the lines of FILE beside its own, as the options a
## series tests on a namespace. The machine must be stopped:
##
##   engines/bash/blktests-machine --machine blktests-nvme-tcp-series \
##       --directory ~/linux --distribution debian-14
. "$(dirname "$0")/workflow"
: "${machine:?} ${directory:?} ${distribution:?}"
state=${XDG_STATE_HOME:-$HOME/.local/state}
: "${backing_file:=$state/machines/blktests-$distribution/work.qcow2}"
: "${ssh_inject:=$HOME/.ssh/guests.pub}"

"$tasks/qemu-system/machine" --machine "$machine" --directory "$directory" \
	--distribution "$distribution"
[ -z "${qemu-}" ] ||
	"$tasks/qemu-system/qemu" --machine "$machine" --directory "$qemu"
[ -z "${drop_in-}" ] ||
	"$tasks/qemu-system/drop-in" --machine "$machine" --file "$drop_in"
"$tasks/${machine%%-*}/config" --machine "$machine"
"$tasks/libguestfs/overlay" --directory "$state/qemu-system/$machine" \
	--backing-file "$backing_file"
"$tasks/libguestfs/customize" --directory "$state/qemu-system/$machine" \
	--hostname "$machine" --ssh-inject "$ssh_inject"
